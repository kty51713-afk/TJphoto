<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.tjphoto.mapper.PhotoMapper">

    <insert id="insertPhoto" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO photo (title, content, member_id, created_at)
        VALUES (#{title}, #{content},#{memberId}, NOW())
    </insert>

   

</mapper>